{
  "$description": "Zenpod design tokens, 0.3.0. W3C Design Tokens format. Mirrors src/lib/tokens.css and src/lib/app.css, which the app actually reads; if they disagree, the CSS wins and this file is out of date.",
  "flavor": {
    "$description": "The two looks the app ships. Day is Flat White (data-flavor=flat), Night is Mocha (data-flavor=mocha). The five other flavors in tokens.css are inherited from the 2050 system and not reachable from Settings.",
    "day": {
      "crust":        { "$type": "color", "$value": "#eceae7" },
      "mantle":       { "$type": "color", "$value": "#f4f2ef" },
      "base":         { "$type": "color", "$value": "#fbfaf8" },
      "surface":      { "$type": "color", "$value": "#ffffff" },
      "raised":       { "$type": "color", "$value": "#e6e3de" },
      "text":         { "$type": "color", "$value": "#3f3f48" },
      "text-muted":   { "$type": "color", "$value": "#62626b" },
      "line":         { "$type": "color", "$value": "#d8d5d0" },
      "line-strong":  { "$type": "color", "$value": "#aaa69f" },
      "hair":         { "$type": "color", "$value": "rgba(0, 0, 0, 0.07)" },
      "accent": {
        "rosewater":  { "$type": "color", "$value": "#a07b74" },
        "flamingo":   { "$type": "color", "$value": "#a86a6a" },
        "pink":       { "$type": "color", "$value": "#a85590" },
        "mauve":      { "$type": "color", "$value": "#734aa0" },
        "red":        { "$type": "color", "$value": "#a8354f" },
        "maroon":     { "$type": "color", "$value": "#944650" },
        "peach":      { "$type": "color", "$value": "#a8652e" },
        "yellow":     { "$type": "color", "$value": "#947a28" },
        "green":      { "$type": "color", "$value": "#457747" },
        "teal":       { "$type": "color", "$value": "#387f73" },
        "sky":        { "$type": "color", "$value": "#2c739b" },
        "sapphire":   { "$type": "color", "$value": "#256597" },
        "blue":       { "$type": "color", "$value": "#355aa0" },
        "lavender":   { "$type": "color", "$value": "#555ea8" }
      },
      "cast-strength": { "$type": "number", "$value": 0.30 },
      "cast-radius":   { "$type": "dimension", "$value": "880px" }
    },
    "night": {
      "crust":        { "$type": "color", "$value": "#11111a" },
      "mantle":       { "$type": "color", "$value": "#171724" },
      "base":         { "$type": "color", "$value": "#1b1b29" },
      "surface":      { "$type": "color", "$value": "#20202f" },
      "raised":       { "$type": "color", "$value": "#2f3147" },
      "text":         { "$type": "color", "$value": "#dfe4f0" },
      "text-muted":   { "$type": "color", "$value": "#8a90a6" },
      "line":         { "$type": "color", "$value": "#2a2a3d" },
      "line-strong":  { "$type": "color", "$value": "#3a3a52" },
      "hair":         { "$type": "color", "$value": "rgba(255, 255, 255, 0.06)" },
      "accent": {
        "rosewater":  { "$type": "color", "$value": "#e2cfcb" },
        "flamingo":   { "$type": "color", "$value": "#e9c5c5" },
        "pink":       { "$type": "color", "$value": "#e4b5d7" },
        "mauve":      { "$type": "color", "$value": "#ba9ae2" },
        "red":        { "$type": "color", "$value": "#e4829e" },
        "maroon":     { "$type": "color", "$value": "#d8939f" },
        "peach":      { "$type": "color", "$value": "#e2a37b" },
        "yellow":     { "$type": "color", "$value": "#e7d1a2" },
        "green":      { "$type": "color", "$value": "#99cf94" },
        "teal":       { "$type": "color", "$value": "#8cd3c7" },
        "sky":        { "$type": "color", "$value": "#80ccda" },
        "sapphire":   { "$type": "color", "$value": "#70b7d8" },
        "blue":       { "$type": "color", "$value": "#7fa6e6" },
        "lavender":   { "$type": "color", "$value": "#a6afe9" }
      },
      "cast-strength": { "$type": "number", "$value": 0.34 },
      "cast-radius":   { "$type": "dimension", "$value": "1000px" }
    }
  },
  "role": {
    "$description": "What components use. Each resolves against the active flavor. Ink steps are colour-mixes toward the ground, so every flavor keeps the same steps.",
    "ground":     { "$type": "color", "$value": "{flavor.*.base}", "$description": "The main window's plane." },
    "surface":    { "$type": "color", "$value": "{flavor.*.surface}", "$description": "Floating surfaces (Mini, Pill, panel), at 62% over the desktop's vibrancy." },
    "line":       { "$type": "color", "$value": "{flavor.*.line}", "$description": "Play-button ring, text-field underline." },
    "hair":       { "$type": "color", "$value": "{flavor.*.hair}", "$description": "Dividers, cover placeholders, hover fill." },
    "text":       { "$type": "color", "$value": "{flavor.*.text}", "$description": "Titles, selected words, primary controls." },
    "text-mid":   { "$type": "color", "$value": "color-mix(in srgb, text 80%, ground)", "$description": "Reading text: notes, transcripts, chapters." },
    "text-dim":   { "$type": "color", "$value": "color-mix(in srgb, text-muted 72%, ground)", "$description": "Secondary lines, icons at rest, numbers." },
    "text-faint": { "$type": "color", "$value": "color-mix(in srgb, text-muted 44%, ground)", "$description": "Labels, unselected words, placeholders." },
    "accent":     { "$type": "color", "$value": "{flavor.*.accent.blue}", "$description": "The person's chosen accent. Default Blue. Played part, playing row, hover, links, focus." },
    "failed":     { "$type": "color", "$value": "{flavor.*.accent.red}", "$description": "Only on hover of a destructive word (Stop following)." },
    "cast":       { "$type": "color", "$value": "#6f8fc9", "$description": "The window light. Taken from the artwork at run time: hsl(h, clamp(25%, s, 60%), 60%). This is the fallback for near-grey artwork." }
  },
  "font": {
    "ui":   { "$type": "fontFamily", "$value": ["Hanken Grotesk Variable", "system-ui", "-apple-system", "sans-serif"] },
    "mono": { "$type": "fontFamily", "$value": ["Fragment Mono", "ui-monospace", "SF Mono", "Menlo", "monospace"] }
  },
  "type": {
    "$description": "The scale in use. Base letter-spacing is 0.01em unless noted.",
    "display": { "$type": "typography", "$value": { "fontFamily": "{font.ui}", "fontWeight": 250, "fontSize": "28px", "lineHeight": 1.18, "letterSpacing": "-0.012em" }, "$description": "Now-playing title, the empty room." },
    "heading": { "$type": "typography", "$value": { "fontFamily": "{font.ui}", "fontWeight": 250, "fontSize": "24px", "lineHeight": 1.2 }, "$description": "Show page, episode notes, Settings." },
    "title-s": { "$type": "typography", "$value": { "fontFamily": "{font.ui}", "fontWeight": 300, "fontSize": "16.5px", "lineHeight": 1.3 }, "$description": "Mini title." },
    "row":     { "$type": "typography", "$value": { "fontFamily": "{font.ui}", "fontWeight": 400, "fontSize": "14.5px", "lineHeight": 1.35 }, "$description": "List rows, library tabs." },
    "body":    { "$type": "typography", "$value": { "fontFamily": "{font.ui}", "fontWeight": 400, "fontSize": "14px", "lineHeight": 1.5 }, "$description": "Default. Reading text uses line-height 1.6, max 42ch." },
    "small":   { "$type": "typography", "$value": { "fontFamily": "{font.ui}", "fontWeight": 400, "fontSize": "13.5px", "lineHeight": 1.45 }, "$description": "Show description, chapters, quiet notes." },
    "sub":     { "$type": "typography", "$value": { "fontFamily": "{font.ui}", "fontWeight": 400, "fontSize": "12.5px", "lineHeight": 1.4 }, "$description": "Meta lines under a title (.sub)." },
    "label":   { "$type": "typography", "$value": { "fontFamily": "{font.ui}", "fontWeight": 400, "fontSize": "12px", "lineHeight": 1.4 }, "$description": "Day headers, Settings labels. Always text-faint." },
    "num":     { "$type": "typography", "$value": { "fontFamily": "{font.mono}", "fontWeight": 400, "fontSize": "11px", "lineHeight": 1.4, "letterSpacing": "0.02em" }, "$description": "Times, durations, speed. Tabular figures." },
    "caps":    { "$type": "typography", "$value": { "fontFamily": "{font.mono}", "fontWeight": 400, "fontSize": "10.5px", "lineHeight": 1.4, "letterSpacing": "0.1em" }, "$description": "Uppercase. Only the Field / Thread / Orbit switch." }
  },
  "size": {
    "cover-now":   { "$type": "dimension", "$value": "136px" },
    "cover-show":  { "$type": "dimension", "$value": "88px" },
    "cover-panel": { "$type": "dimension", "$value": "44px" },
    "cover-row-show":    { "$type": "dimension", "$value": "40px" },
    "cover-row-episode": { "$type": "dimension", "$value": "34px" },
    "play-main":   { "$type": "dimension", "$value": "50px" },
    "play-mini":   { "$type": "dimension", "$value": "42px" },
    "play-panel":  { "$type": "dimension", "$value": "40px" },
    "play-pill":   { "$type": "dimension", "$value": "32px" },
    "hit-icon":    { "$type": "dimension", "$value": "28px" },
    "swatch":      { "$type": "dimension", "$value": "22px" },
    "library-min":     { "$type": "dimension", "$value": "300px" },
    "library-default": { "$type": "dimension", "$value": "400px" },
    "library-max":     { "$type": "dimension", "$value": "560px" },
    "listen-min":      { "$type": "dimension", "$value": "620px" }
  },
  "radius": {
    "cover-large": { "$type": "dimension", "$value": "9px" },
    "cover-panel": { "$type": "dimension", "$value": "7px" },
    "cover-row":   { "$type": "dimension", "$value": "6px" },
    "mini":        { "$type": "dimension", "$value": "18px" },
    "panel":       { "$type": "dimension", "$value": "18px" },
    "pill":        { "$type": "dimension", "$value": "24px" },
    "focus":       { "$type": "dimension", "$value": "4px" },
    "round":       { "$type": "dimension", "$value": "999px" }
  },
  "space": {
    "listen-pad":  { "$type": "dimension", "$value": "64px 48px 44px" },
    "library-pad": { "$type": "dimension", "$value": "12px 22px 20px 32px" },
    "row-y":       { "$type": "dimension", "$value": "9px" },
    "row-gap":     { "$type": "dimension", "$value": "14px" },
    "section":     { "$type": "dimension", "$value": "22px" },
    "words-gap":   { "$type": "dimension", "$value": "18px" },
    "transport-main":  { "$type": "dimension", "$value": "30px" },
    "transport-panel": { "$type": "dimension", "$value": "24px" },
    "transport-mini":  { "$type": "dimension", "$value": "18px" }
  },
  "stroke": {
    "icon":  { "$type": "dimension", "$value": "1.1px", "$description": "Skip, previous/next, settings. Play and pause use 1.2px." },
    "ring":  { "$type": "dimension", "$value": "1px" },
    "focus": { "$type": "dimension", "$value": "1.5px" }
  },
  "motion": {
    "ease-out":    { "$type": "cubicBezier", "$value": [0.23, 1, 0.32, 1], "$description": "Default. Entering, exiting, release." },
    "ease-in-out": { "$type": "cubicBezier", "$value": [0.77, 0, 0.175, 1], "$description": "Moving on screen." },
    "hover":       { "$type": "duration", "$value": "140ms", "$description": "Colour on hover, with plain ease." },
    "pane":        { "$type": "duration", "$value": "200ms", "$description": "Quiet notes and new rows arriving; mode fold-away." },
    "arrive":      { "$type": "duration", "$value": "280ms", "$description": "A surface arriving after a mode change." },
    "light":       { "$type": "duration", "$value": "400ms", "$description": "The cast light fading on or off." },
    "cap":         { "$type": "duration", "$value": "300ms", "$description": "Nothing the person triggers is slower. The light is ambient, not triggered." },
    "fold-scale":  { "$type": "number", "$value": 0.96 }
  }
}
